generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Settings {
  id          String  @id @default("settings")
  companyName String?
  logoUrl     String?
}

model Person {
  id        String   @id @default(cuid())
  nama      String
  jabatan   String
  divisi    String?
  jobdesk   String?
  fotoUrl   String?
  atasanId  String?
  /// Manual chart layout; null = auto. posX/posY: card top-left; busY: this person's bus line y;
  /// trunkX: own trunk x from card left; linkOff: where the line from the boss meets this card.
  posX      Float?
  posY      Float?
  busY      Float?
  trunkX    Float?
  linkOff   Float?
  /// top | bottom | left | right: side of this card the line from the boss attaches to.
  linkSide  String?
  /// Person id whose lines this card's connector is drawn from instead of the boss's (visual only).
  linkVia   String?
  atasan    Person?  @relation("Reports", fields: [atasanId], references: [id])
  bawahan   Person[] @relation("Reports")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
